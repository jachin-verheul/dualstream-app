const streamMap = new Map();

function showError(message) {
  const box = document.getElementById('error-box');
  box.textContent = message;
  box.classList.add('visible');

  window.clearTimeout(showError.timeoutId);
  showError.timeoutId = window.setTimeout(() => {
    box.classList.remove('visible');
    box.textContent = '';
  }, 5000);
}

function updateActiveCount() {
  document.getElementById('active-streams').textContent = String(streamMap.size);
}

function setCameraStatus(cameraNumber, statusText) {
  document.getElementById(`cam${cameraNumber}-status`).textContent = statusText;
}

function setSignalText(cameraNumber, text) {
  const signal = document.getElementById(`signal${cameraNumber}`);
  if (signal) signal.textContent = text;
}

function setOverlay(cameraNumber, visible) {
  const overlay = document.getElementById(`overlay${cameraNumber}`);
  if (overlay) {
    overlay.classList.toggle('hidden', !visible);
  }
}

async function getCameraDevices() {
  if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) {
    throw new Error('This browser does not support camera enumeration.');
  }

  const devices = await navigator.mediaDevices.enumerateDevices();
  return devices.filter((device) => device.kind === 'videoinput');
}

async function startCamera(cameraNumber) {
  const videoElement = document.getElementById(`video${cameraNumber}`);
  const camStatusElement = document.getElementById(`cam${cameraNumber}-status`);

  try {
    const cameras = await getCameraDevices();
    const selectedCamera = cameras[cameraNumber - 1] || cameras[0];

    if (!selectedCamera) {
      throw new Error('Geen webcam gevonden in deze browser sessie.');
    }

    const stream = await navigator.mediaDevices.getUserMedia({
      video: {
        deviceId: selectedCamera.deviceId ? { exact: selectedCamera.deviceId } : undefined,
        facingMode: cameraNumber === 2 ? 'environment' : 'user'
      },
      audio: false
    });

    videoElement.srcObject = stream;
    streamMap.set(cameraNumber, stream);
    camStatusElement.textContent = 'Live';
    setOverlay(cameraNumber, false);
    setSignalText(cameraNumber, 'Connected');
    updateActiveCount();
  } catch (error) {
    showError(`Camera ${cameraNumber} kon niet starten: ${error.message}`);
    setCameraStatus(cameraNumber, 'Error');
    setSignalText(cameraNumber, 'Error');
    setOverlay(cameraNumber, true);
  }
}

function stopCamera(cameraNumber) {
  const stream = streamMap.get(cameraNumber);
  const videoElement = document.getElementById(`video${cameraNumber}`);

  if (stream) {
    stream.getTracks().forEach((track) => track.stop());
    streamMap.delete(cameraNumber);
  }

  if (videoElement) {
    videoElement.srcObject = null;
  }

  setCameraStatus(cameraNumber, 'Ready');
  setSignalText(cameraNumber, 'Waiting');
  setOverlay(cameraNumber, true);
  updateActiveCount();
}

async function checkServerStatus() {
  try {
    const response = await fetch('/api/status');
    const data = await response.json();
    const statusText = data.status === 'online' ? 'Connected' : 'Offline';

    document.getElementById('server-status').textContent = statusText;
    document.getElementById('server-time').textContent = new Date(data.timestamp).toLocaleTimeString();
    document.getElementById('protocol-status').textContent = data.secure ? 'HTTPS' : 'HTTP';
    document.getElementById('secure-status').textContent = data.secure ? 'Secure' : 'Local';
  } catch (error) {
    document.getElementById('server-status').textContent = 'Offline';
    document.getElementById('secure-status').textContent = 'Local';
    document.getElementById('protocol-status').textContent = 'HTTP';
    showError('Server connection failed.');
  }
}

function initButtons() {
  document.getElementById('start1').addEventListener('click', () => startCamera(1));
  document.getElementById('stop1').addEventListener('click', () => stopCamera(1));
  document.getElementById('start2').addEventListener('click', () => startCamera(2));
  document.getElementById('stop2').addEventListener('click', () => stopCamera(2));
}

function initClock() {
  setInterval(() => {
    document.getElementById('server-time').textContent = new Date().toLocaleTimeString();
  }, 1000);
}

async function init() {
  initButtons();
  updateActiveCount();
  checkServerStatus();
  initClock();
  setInterval(checkServerStatus, 10000);
}

init();

window.addEventListener('beforeunload', () => {
  streamMap.forEach((stream) => {
    stream.getTracks().forEach((track) => track.stop());
  });
});


















































































































































































































































































































































